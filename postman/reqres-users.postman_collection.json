{
  "info": {
    "name": "Makers - Módulo API (reqres.in)",
    "description": "Colección complementaria para ejecución manual o con Newman: newman run postman/reqres-users.postman_collection.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://reqres.in/api" },
    { "key": "apiKey", "value": "reqres-free-v1" },
    { "key": "userName", "value": "Test User" },
    { "key": "userJob", "value": "Automation Engineer" },
    { "key": "userId", "value": "" }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-api-key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "1. POST /users - crear usuario",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "const body = pm.response.json();",
          "pm.test('Status 201', () => pm.response.to.have.status(201));",
          "pm.test('Devuelve name y job enviados', () => {",
          "  pm.expect(body.name).to.eql(pm.collectionVariables.get('userName'));",
          "  pm.expect(body.job).to.eql(pm.collectionVariables.get('userJob'));",
          "});",
          "pm.test('Incluye id y createdAt', () => {",
          "  pm.expect(body.id).to.be.a('string').and.not.empty;",
          "  pm.expect(new Date(body.createdAt).toString()).to.not.eql('Invalid Date');",
          "});",
          "pm.test('Tiempo de respuesta < 3000 ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
          "pm.collectionVariables.set('userId', body.id);"
        ]}
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"name\": \"{{userName}}\", \"job\": \"{{userJob}}\"}" },
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
      }
    },
    {
      "name": "2. GET /users/{id} - consultar usuario creado (BUG-API-01: reqres no persiste)",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 200', () => pm.response.to.have.status(200));",
          "pm.test('name y job iguales a los enviados', () => {",
          "  const body = pm.response.json();",
          "  const user = body.data || body;",
          "  pm.expect(user.name).to.eql(pm.collectionVariables.get('userName'));",
          "  pm.expect(user.job).to.eql(pm.collectionVariables.get('userJob'));",
          "});"
        ]}
      }],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
      }
    },
    {
      "name": "3. GET /users/2 - usuario existente",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 200', () => pm.response.to.have.status(200));",
          "pm.test('Usuario 2 con correo esperado', () => {",
          "  const d = pm.response.json().data;",
          "  pm.expect(d.id).to.eql(2);",
          "  pm.expect(d.email).to.eql('janet.weaver@reqres.in');",
          "});"
        ]}
      }],
      "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/users/2", "host": ["{{baseUrl}}"], "path": ["users", "2"] } }
    },
    {
      "name": "4. GET /users/23 - usuario inexistente",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 404', () => pm.response.to.have.status(404));"
        ]}
      }],
      "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/users/23", "host": ["{{baseUrl}}"], "path": ["users", "23"] } }
    }
  ]
}
